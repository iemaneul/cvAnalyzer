generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id             String   @id @default(cuid())
  fileName       String
  extractionMethod String?
  jobTitle        String?
  company         String?
  applicationStatus String @default("planned")
  jobUrl          String?
  salary          String?
  workMode        String?
  notes           String?
  jobDescription String
  score          Int
  resumeSkills   Json
  jobSkills      Json
  matchedSkills  Json
  missingSkills  Json
  suggestions    Json
  skillRequirements Json?
  evidence          Json?
  scoreBreakdown    Json?
  evidenceQuality   Int?
  experienceComparisons Json?
  experienceAlignment   Int?
  qualifications        Json?
  actionPlan            Json?
  competencies          Json?
  structure             Json?
  createdAt      DateTime @default(now())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  analyses     Analysis[]
}
